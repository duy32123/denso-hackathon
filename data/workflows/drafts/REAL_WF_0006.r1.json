    {
      "claim_id": "REAL_WF_0006_CL_003",
      "text": "The presenter says the spindle motor has a temperature sensor built into it, usually in the junction box, with factory-preset temperature limits, and that the sensor triggers alarm 254 when the motor temperature begins to reach those limits.",
      "role": "rationale",
      "evidence_type": "stated",
      "attribution": {
        "actor_id": null,
        "label": "Orville Collins (presenter)",
        "kind": "speaker"
      },
      "scope": {
        "level": "case",
        "description": "Alarm 254 troubleshooting as demonstrated in SRC_HAAS_0010."
      },
      "evidence_links": [
        {
          "evidence_id": "REAL_WF_0006_EV_007",
          "support_status": "supported",
          "explanation": "The captions state this directly. Cue 4 is corrected from 'alarm to 54' to 'alarm 254'."
        }
      ],
      "support_status": "supported",
      "source_review": "pending",
      "technical_review": "not_requested",
      "conflicts_with": [],
      "supersedes_claim_ids": []
    },
    {
